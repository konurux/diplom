# Скопируйте в backend/.env и заполните. На Render задайте те же переменные в Environment.
MONGO_URL=mongodb://localhost:27017
DB_NAME=pixvault
# Длинная случайная строка: python3 -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=

# Администратор создаётся/обновляется при старте. Пароль — минимум 10 символов.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Фронтенды, которым разрешены запросы с cookie (через запятую). localhost разрешён всегда.
ALLOWED_ORIGINS=https://diplom-kappa-three.vercel.app
