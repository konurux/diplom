{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/u/:ref",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(bot|Bot|BOT|crawler|Crawler|spider|Spider|facebookexternalhit|WhatsApp|vkShare|Viber|SkypeUriPreview|Embedly|Preview|preview).*" }],
      "destination": "https://diplom-sn76.onrender.com/api/og/u/:ref"
    },
    {
      "source": "/design/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(bot|Bot|BOT|crawler|Crawler|spider|Spider|facebookexternalhit|WhatsApp|vkShare|Viber|SkypeUriPreview|Embedly|Preview|preview).*" }],
      "destination": "https://diplom-sn76.onrender.com/api/og/design/:id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
